# HTTP server port
PORT=3000

# Static URLs returned by transform logic
SINGLE_EVENT_URL=https://bi1-nicolas.s3.eu-west-1.amazonaws.com/single-event.json
MULTIPLE_EVENTS_URL=https://bi1-nicolas.s3.eu-west-1.amazonaws.com/multiple-events.json

# MQTT transport (leave MQTT_BROKER_URL empty to disable MQTT mode)
MQTT_BROKER_URL=
MQTT_NAMESPACE=stack1
MQTT_SERVICE_NAME=transform
MQTT_SCHEMA_VERSION=1.0

# Optional MQTT client authentication/identity
MQTT_CLIENT_ID=transform-service
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT QoS levels: 0, 1, or 2
MQTT_SUBSCRIBE_QOS=1
MQTT_PUBLISH_QOS=1

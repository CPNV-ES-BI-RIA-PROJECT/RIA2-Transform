#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/nicolas_glassey/Desktop/Artisan-it/ics-converter/node_modules/.pnpm/@tsoa+cli@7.0.0-alpha.0/node_modules/@tsoa/cli/node_modules:/home/nicolas_glassey/Desktop/Artisan-it/ics-converter/node_modules/.pnpm/@tsoa+cli@7.0.0-alpha.0/node_modules:/home/nicolas_glassey/Desktop/Artisan-it/ics-converter/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/nicolas_glassey/Desktop/Artisan-it/ics-converter/node_modules/.pnpm/@tsoa+cli@7.0.0-alpha.0/node_modules/@tsoa/cli/node_modules:/home/nicolas_glassey/Desktop/Artisan-it/ics-converter/node_modules/.pnpm/@tsoa+cli@7.0.0-alpha.0/node_modules:/home/nicolas_glassey/Desktop/Artisan-it/ics-converter/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@tsoa/cli/dist/cli.js" "$@"
else
  exec node  "$basedir/../@tsoa/cli/dist/cli.js" "$@"
fi

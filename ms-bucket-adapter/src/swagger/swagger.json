{
	"openapi": "3.0.0",
	"components": {
		"examples": {},
		"headers": {},
		"parameters": {},
		"requestBodies": {},
		"responses": {},
		"schemas": {
			"UploadObjectResponseDto": {
				"properties": {
					"key": {
						"type": "string",
						"description": "Key of the uploaded file in the S3 bucket"
					}
				},
				"required": [
					"key"
				],
				"type": "object",
				"additionalProperties": false
			},
			"UploadObjectRequestDto": {
				"properties": {
					"fileName": {
						"type": "string",
						"description": "Name of the file to store in S3"
					},
					"content": {
						"type": "string",
						"description": "Content of the file as a string (JSON string or plain text)"
					}
				},
				"required": [
					"fileName",
					"content"
				],
				"type": "object",
				"additionalProperties": false
			},
			"PublishObjectResponseDto": {
				"properties": {
					"url": {
						"type": "string",
						"description": "Presigned URL to access the file"
					}
				},
				"required": [
					"url"
				],
				"type": "object",
				"additionalProperties": false
			}
		},
		"securitySchemes": {}
	},
	"info": {
		"title": "bucket-adapter-microservice",
		"version": "1.0.0",
		"description": "bucket-adapter-microservice",
		"contact": {}
	},
	"paths": {
		"/v1/objects/health": {
			"get": {
				"operationId": "Healthcheck",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"status": {
											"type": "string"
										}
									},
									"required": [
										"status"
									],
									"type": "object"
								}
							}
						}
					}
				},
				"security": [],
				"parameters": []
			}
		},
		"/v1/objects": {
			"post": {
				"operationId": "UploadObject",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/UploadObjectResponseDto"
								}
							}
						}
					}
				},
				"description": "Upload a file to S3",
				"security": [],
				"parameters": [],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/UploadObjectRequestDto"
							}
						}
					}
				}
			}
		},
		"/v1/objects/{fileName}/publish": {
			"post": {
				"operationId": "PublishObject",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PublishObjectResponseDto"
								}
							}
						}
					}
				},
				"description": "Generate a presigned URL for a file in S3",
				"security": [],
				"parameters": [
					{
						"in": "path",
						"name": "fileName",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				]
			}
		}
	},
	"servers": [
		{
			"url": "/api"
		}
	]
}
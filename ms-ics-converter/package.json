{
  "name": "ics-transform-microservice",
  "version": "1.0.0",
  "description": "ICS transform microservice",
  "main": "dist/main/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc & pnpm generate",
    "dev": "tsc --watch & nodemon dist/main/server.js",
    "dev:watch": "pnpm build:watch & pnpm start:watch",
    "build:watch": "tsc --watch",
    "start": "node dist/main/server.js",
    "start:watch": "nodemon --watch dist --ext js --exec node dist/main/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "tsoa:routes": "tsoa routes",
    "tsoa:spec": "tsoa spec",
    "generate": "pnpm run tsoa:routes && pnpm run tsoa:spec"
  },
  "dependencies": {
    "@tsoa/runtime": "7.0.0-alpha.0",
    "axios": "^1.5.0",
    "express": "^4.18.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.5.1",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.6.1",
    "runtime": "link:@types/tsoa/runtime",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "tsoa": "^7.0.0-alpha.0",
    "typescript": "^5.2.2"
  }
}